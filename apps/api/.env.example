PORT=3000
# フェーズ0 PoC の poc.verifyIcRead を有効にする(開発環境のみ。認証なし)
ZAIRYU_ENABLE_POC=1
# 信頼する発行者(入管庁)の証明書ファイル。未入手のため空(署名結果は「発行者未確認」になる)
ZAIRYU_TRUSTED_ISSUERS=

# --- 認証(1-2)を使う場合。DATABASE_URL を設定すると下の鍵が必須になる ---
# 接続ユーザーは zairyu_app / zairyu_platform / zairyu_purge のメンバー(packages/db/README.md)
# DATABASE_URL=postgres://zairyu_api:dev@localhost:5432/zairyu
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_JWT_SECRET=
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET_BOX_KEY=

# --- 暗号化(1-4)。設定しない場合、カード番号・画像を扱う API は使えない ---
# 本番: VAULT_KEY_PROVIDER=azure、AZURE_KEY_VAULT_KEY_ID=https://<vault>.vault.azure.net/keys/<name>
# VAULT_KEY_PROVIDER=local
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# VAULT_LOCAL_KEK=
# 本番: BLOB_STORE=azure、AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net、AZURE_STORAGE_CONTAINER=card-images
# BLOB_STORE=fs
# BLOB_FS_DIR=./.blobs
# 端末から見た API の URL(画像 URL に使う)
# PUBLIC_BASE_URL=http://192.168.0.10:3000
