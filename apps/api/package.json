{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:init-env": "tsx src/scripts/initEnv.ts",
    "dev:setup": "tsx --env-file-if-exists=.env src/scripts/devSetup.ts",
    "platform:create-operator": "tsx --env-file-if-exists=.env src/scripts/createOperator.ts",
    "platform:operator": "tsx --env-file-if-exists=.env src/scripts/manageOperator.ts",
    "postal:load": "tsx --env-file-if-exists=.env src/scripts/loadPostalCodes.ts"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "1.3.6",
    "@node-rs/argon2": "^2.2.2",
    "@trpc/server": "^11.29.5",
    "@zairyu/db": "workspace:*",
    "@zairyu/shared": "workspace:*",
    "@zairyu/vault": "workspace:*",
    "@zairyu/zairyu-ic": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.2",
    "jose": "6.2.15",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "exports": {
    "./router": {
      "types": "./dist/router.d.ts"
    }
  }
}
